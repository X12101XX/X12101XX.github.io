extends _partial/base.pug
include _partial/icons
block content
  - var tags = site.tags.toArray().sort(function (a, b) { return b.length - a.length || a.name.localeCompare(b.name); })
  main#main.site-main.tags-page
    .shell
      header.page-head
        p.eyebrow
          span= theme.tags.kicker || 'TAGS'
          span.eyebrow-cn= theme.tags.kicker_cn || '标签索引'
        h1.page-title
          span= theme.tags.heading_before || '串联不同笔记的'
          em= theme.tags.heading_em || '关键词线索'
        p.page-lede= theme.tags.lede
        .page-head-meta
          span 共 #{tags.length} 个标签
          a.page-head-link(href=url_for('/categories/'))
            span 浏览主题分类
            +icon('arrow-right', 13)
      if tags.length
        .tag-cloud
          each tag in tags
            a.tag-pill.spotlight-card(href=url_for(tag.path))
              span.tag-pill-hash #
              span.tag-pill-name= tag.name
              span.tag-pill-count= tag.length
        .tags-foot
          p 每一个标签都是一条线索，顺着它可以串起不同的思考片段。
          a.journal-tail-link(href=url_for('/archives/'))
            span 查看完整时间线
            +icon('arrow-right', 15)
      else
        .empty-state
          h2 暂无标签
          p 随着文章增多，标签网络会自动长出来。
