extends _partial/base.pug
include _partial/icons
block content
  - var rawPosts = site.posts && typeof site.posts.sort === 'function' ? site.posts.sort('-date') : site.posts
  - var validPosts = (typeof valid_posts === 'function' ? valid_posts(rawPosts) : (rawPosts ? rawPosts.toArray() : [])).filter(function (post) { return post && post.published !== false && post.title && String(post.title).trim(); })
  - var recentPosts = validPosts.slice(0, 6)
  - var landing = theme.landing || {}
  main#main.home
    .shell
      section.home-hero(aria-label='扉页引言')
        .home-poem
          span.seal-stamp 格物
          h1.home-title= (landing.title_prefix || 'X12101XX 的') + (landing.title_gradient || '代码与思考笔记')
          p.home-lede= config.description
          .home-links
            a.home-link-primary(href=url_for('/posts/')) 阅读文章 →
            a.home-link-quiet(href=url_for('/about/')) 关于作者
        aside.home-vertical-epigraph(aria-hidden='true')
          p 格物致知 · 缓慢书写
          p 记代码、类型与逻辑之思
      if recentPosts.length
        section.home-toc(aria-label='近期篇目')
          .home-section-head
            h2.section-title 近期篇目
            a.section-more(href=url_for('/posts/')) 全部文章 (#{validPosts.length})
          .home-toc-list
            each post in recentPosts
              a.home-toc-item(href=url_for(post.path))
                span.home-toc-title= post.title
                span.home-toc-leader(aria-hidden='true')
                time.home-toc-date(datetime=date(post.date, 'YYYY-MM-DD'))= date(post.date, 'YYYY · MM · DD')
      nav.home-foot-nav(aria-label='站点索引')
        a(href=url_for('/posts/')) 文章
        a(href=url_for('/archives/')) 归档
        a(href=url_for('/categories/')) 分类
        a(href=url_for('/tags/')) 标签
        a(href=url_for('/friends/')) 友链
        a(href=url_for('/about/')) 关于
