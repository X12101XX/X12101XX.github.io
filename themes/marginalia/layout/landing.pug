extends _partial/base.pug
include _partial/icons
block content
  - var socials = theme.social || []
  - var latest = site.posts.toArray()[0]
  - var since = theme.footer && theme.footer.since ? theme.footer.since : 2026
  - var now = new Date().getFullYear()
  - var landing = theme.landing || {}
  - var primary = landing.primary || { label: 'Notes', path: '/posts/' }
  - var secondary = landing.secondary || { label: 'Friends', path: '/friends/' }
  - var titleText = landing.title || config.subtitle || 'Code & Quiet Things'
  - var noteCount = String(site.posts.length).padStart(2, '0')
  - var lit = ['0-0', '0-4', '1-1', '1-3', '2-2', '3-1', '3-3', '4-0', '4-4']
  .home
    .shell.home-hero
      .home-copy
        p.home-kicker.mono Personal index — #{now}
        h1.home-title= titleText
        p.home-lede= config.description
        .home-actions
          a.btn.btn--solid(href=url_for(primary.path))
            span= primary.label
            +icon('arrow', 14)
          a.btn.btn--line(href=url_for(secondary.path))
            span= secondary.label
            +icon('arrow', 14)
        nav.home-socials(aria-label='Elsewhere')
          each item in socials
            a(href=url_for(item.url), target=item.url.startsWith('http') ? '_blank' : false, rel=item.url.startsWith('http') ? 'noopener noreferrer' : false)
              span= item.name
              +icon('arrow', 13)
      aside.home-panel
        .glyph(aria-hidden='true')
          each r in [0, 1, 2, 3, 4]
            each c in [0, 1, 2, 3, 4]
              - var cell = r + '-' + c
              span(class=(r === 2 && c === 2 ? 'is-signal' : (lit.indexOf(cell) !== -1 ? 'is-on' : '')))
        .home-panel-head
          span.mono Glyph
          span.dot-num 01
        dl.home-facts
          div
            dt.mono Notes
            dd.dot-num= noteCount
          div
            dt.mono Updated
            dd.dot-num= latest ? date(latest.date, 'YYYY.MM.DD') : '—'
          div
            dt.mono Since
            dd.dot-num= since
    if latest
      section.home-latest(aria-label='Latest note')
        .shell.home-latest-inner
          span.home-latest-label.mono Latest note
          a.home-latest-title(href=url_for(latest.path))= latest.title
          time.home-latest-date.dot-num(datetime=date(latest.date, 'YYYY-MM-DD'))= date(latest.date, 'YYYY.MM.DD')
          +icon('arrow', 18)
    nav.home-index(aria-label='Sections')
      .shell.home-index-inner
        a(href=url_for('/posts/'))
          span.dot-num 01
          span Notes
        a(href=url_for('/archives/'))
          span.dot-num 02
          span Archive
        a(href=url_for('/friends/'))
          span.dot-num 03
          span Friends
        a(href=url_for('/about/'))
          span.dot-num 04
          span About
