extends _partial/base.pug
include _partial/icons
block content
  - var socials = theme.social || []
  - var rawPosts = site.posts && typeof site.posts.sort === 'function' ? site.posts.sort('-date') : site.posts
  - var validPosts = (typeof valid_posts === 'function' ? valid_posts(rawPosts) : (rawPosts ? rawPosts.toArray() : [])).filter(function (post) { return post && post.published !== false && post.title && String(post.title).trim(); })
  - var latest = validPosts[0]
  - var latestCats = latest && latest.categories ? latest.categories.toArray() : []
  - var recentPosts = validPosts.slice(0, 3)
  - var since = theme.footer && theme.footer.since ? theme.footer.since : 2026
  - var now = new Date().getFullYear()
  - var landing = theme.landing || {}
  - var primary = landing.primary || { label: 'Notes', path: '/posts/' }
  - var secondary = landing.secondary || { label: 'Friends', path: '/friends/' }
  - var titleText = landing.title || config.subtitle || 'Code & Quiet Things'
  - var noteCount = String(validPosts.length).padStart(2, '0')
  - var topicCount = String((site.categories ? site.categories.length : 0) + (site.tags ? site.tags.length : 0)).padStart(2, '0')
  - var lit = ['0-0', '0-4', '1-1', '1-3', '2-2', '3-1', '3-3', '4-0', '4-4']
  .home
    .shell.home-hero
      .home-copy
        p.home-kicker.mono Personal index — #{now}
        h1.home-title= titleText
        p.home-lede= config.description
        .home-actions
          a.btn.btn--solid(href=url_for(primary.path))
            span= primary.label
            +icon('arrow', 14)
          a.btn.btn--line(href=url_for(secondary.path))
            span= secondary.label
            +icon('arrow', 14)
        nav.home-socials(aria-label='Elsewhere')
          each item in socials
            - var isExternal = item.url && /^https?:\/\//i.test(item.url)
            a(href=url_for(item.url), target=isExternal ? '_blank' : false, rel=isExternal ? 'noopener noreferrer' : false)
              span= item.name
              +icon('arrow', 13)
      aside.home-panel
        .glyph(data-glyph-grid, aria-hidden='true')
          each r in [0, 1, 2, 3, 4]
            each c in [0, 1, 2, 3, 4]
              - var cell = r + '-' + c
              span(class=(r === 2 && c === 2 ? 'is-signal' : (lit.indexOf(cell) !== -1 ? 'is-on' : '')))
        .home-panel-head
          span.mono Glyph
          button.glyph-switch.dot-num(type='button', data-glyph-switch, aria-label='Switch matrix pattern', title='Switch matrix pattern') 01
        dl.home-facts
          div
            dt.mono Notes
            dd.dot-num= noteCount
          div
            dt.mono Topics
            dd.dot-num= topicCount
          div
            dt.mono Updated
            dd.dot-num= latest ? date(latest.date, 'YYYY.MM.DD') : '—'
          div
            dt.mono Since
            dd.dot-num= since
    if latest
      section.home-latest(aria-label='Latest note')
        .shell.home-latest-inner
          span.home-latest-label.mono Latest note
          a.home-latest-title(href=url_for(latest.path))= latest.title
          .home-latest-meta
            if latestCats.length
              span.home-latest-badge.mono= latestCats[0].name
            span #{reading_time(latest.content)} min read
            time.home-latest-date.dot-num(datetime=date(latest.date, 'YYYY-MM-DD'))= date(latest.date, 'YYYY.MM.DD')
          +icon('arrow', 18)
    if recentPosts.length
      section.home-recent(aria-label='Recent notes')
        .shell
          .home-recent-head
            h2.home-recent-label.mono Recent notes
            a(href=url_for('/posts/'))
              span All notes
              +icon('arrow', 13)
          .home-recent-grid
            each post, index in recentPosts
              - var postCats = post.categories ? post.categories.toArray() : []
              - var postNum = String(index + 1).padStart(2, '0')
              a.home-recent-card(href=url_for(post.path))
                .home-recent-meta
                  span.dot-num= postNum
                  time(datetime=date(post.date, 'YYYY-MM-DD'))= date(post.date, 'YYYY.MM.DD')
                  if postCats.length
                    span ·
                    span= postCats[0].name
                h3.home-recent-title= post.title
                if post_excerpt(post, 120)
                  p.home-recent-excerpt= post_excerpt(post, 120)
                .home-recent-foot
                  span.mono #{reading_time(post.content)} min read
                  +icon('arrow', 14)
    nav.home-index(aria-label='Sections')
      .shell.home-index-inner
        a(href=url_for('/posts/'))
          span.dot-num 01
          span Notes
        a(href=url_for('/archives/'))
          span.dot-num 02
          span Archive
        a(href=url_for('/categories/'))
          span.dot-num 03
          span Categories
        a(href=url_for('/tags/'))
          span.dot-num 04
          span Tags
        a(href=url_for('/friends/'))
          span.dot-num 05
          span Friends
        a(href=url_for('/about/'))
          span.dot-num 06
          span About
