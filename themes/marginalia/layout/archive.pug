extends _partial/base.pug
include _partial/icons
block content
  - var rawPosts = page.posts ? page.posts.toArray() : []
  - var posts = (typeof valid_posts === 'function' ? valid_posts(rawPosts) : rawPosts).filter(function (post) { return post && post.published !== false && post.title && String(post.title).trim(); })
  - var rawSitePosts = site.posts && typeof site.posts.sort === 'function' ? site.posts.sort('-date') : site.posts
  - var totalCount = (typeof valid_posts === 'function' ? valid_posts(rawSitePosts) : (rawSitePosts ? rawSitePosts.toArray() : [])).filter(function (post) { return post && post.published !== false && post.title && String(post.title).trim(); }).length
  -
    var groups = [];
    posts.forEach(function (post) {
      var year = date(post.date, 'YYYY');
      var group = groups.find(function (item) { return item.year === year; });
      if (!group) {
        group = { year: year, posts: [] };
        groups.push(group);
      }
      group.posts.push(post);
    });
  main#main.site-main.archive-page
    .shell
      header.page-head.archive-head
        p.eyebrow
          span Archive
          span.eyebrow-cn 归档
        h1.page-title
          span= theme.archive.heading_before + ' '
          em= theme.archive.heading_em
        p.page-lede= theme.archive.lede
        .page-head-meta
          span #{totalCount} #{totalCount === 1 ? 'note' : 'notes'}
          span Since #{theme.footer.since || 2026}
      if groups.length
        .archive
          each group in groups
            section.archive-year
              .archive-year-head
                h2.archive-year-label= group.year
                span.archive-year-count.mono #{String(group.posts.length).padStart(2, '0')} #{group.posts.length === 1 ? 'note' : 'notes'}
              .archive-year-list
                each post in group.posts
                  - var postCats = post.categories ? post.categories.toArray() : []
                  a.archive-item(href=url_for(post.path))
                    time.archive-item-date(datetime=date(post.date, 'YYYY-MM-DD'))= date(post.date, 'MM.DD')
                    span.archive-item-title= post.title
                    if postCats.length
                      span.archive-item-cat.mono= postCats[0].name
                    span.archive-item-read #{reading_time(post.content)} min
                    span.archive-item-arrow
                      +icon('arrow', 16)
        include _partial/pagination
      else
        .empty-state
          h2 The archive is still empty.
          p A page or two will find its way here.
          a.btn.btn--line(href=url_for('/'))
            span Return home
            +icon('arrow-right', 15)
