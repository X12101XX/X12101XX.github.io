include icons
.search-overlay(id='search-overlay', hidden, data-index=url_for(theme.search.path || '/search.xml'))
  .search-backdrop(data-search-close)
  .search-panel(role='dialog', aria-modal='true', aria-labelledby='search-label')
    .search-head
      p.search-kicker
        +icon('sparkles', 14)
        span 全站检索
      button.search-close(type='button', data-search-close, aria-label='关闭搜索')
        +icon('close', 16)
    .search-bar
      +icon('search', 18)
      label.sr-only(id='search-label') 搜索文章
      input#search-input(type='search', placeholder='搜索文章标题、标签或正文...', autocomplete='off', spellcheck='false', aria-controls='search-results')
    .search-body
      p.search-status(id='search-status') 输入关键词开始检索（支持空格分词）
      ul.search-results(id='search-results')
    .search-foot
      span
        kbd ↑
        kbd ↓
        |  选择
      span
        kbd ↵
        |  打开
      span
        kbd Esc
        |  关闭
