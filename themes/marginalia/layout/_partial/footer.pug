include icons
- var since = theme.footer && theme.footer.since ? theme.footer.since : 2026
- var now = new Date().getFullYear()
- var years = since === now ? String(now) : since + '–' + now
footer.site-footer
  .shell.footer-inner
    .footer-brand
      span.footer-mark(aria-hidden='true')
      p.footer-copy © #{years} #{(theme.author && theme.author.name) || config.author}
      span.footer-sep.mono /
      p.footer-note= (theme.footer && theme.footer.note) || '缓慢地写，诚实地写'
    nav.footer-links(aria-label='页脚导航')
      a(href=url_for('/posts/')) 文章
      a(href=url_for('/archives/')) 归档
      a(href=url_for('/categories/')) 分类
      a(href=url_for('/tags/')) 标签
      a(href=url_for('/friends/')) 友链
      a(href=url_for('/about/')) 关于
      if theme.author && theme.author.github
        a(href=theme.author.github, target='_blank', rel='noopener noreferrer') GitHub
      a(href=url_for('/atom.xml')) RSS
      a.footer-top(href='#top') ↑ TOP
