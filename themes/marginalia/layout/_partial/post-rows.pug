include icons
.post-list
  each post, index in posts
    - var tags = post.tags ? post.tags.toArray().slice(0, 3) : []
    - var categories = post.categories ? post.categories.toArray() : []
    - var charText = typeof word_count === 'function' ? word_count(post.content) : ''
    article.post-row.spotlight-card
      .post-row-body
        .post-row-top
          if featured && index === 0
            span.post-row-flag 最新文章
          time.post-row-date(datetime=date(post.date, 'YYYY-MM-DD'))= date(post.date, 'YYYY-MM-DD')
          if categories.length
            span.dot ·
            span.post-row-category= categories[0].name
          if charText
            span.dot ·
            span 约 #{charText} 字
          span.dot ·
          span #{reading_time(post.content)} 分钟阅读
        h2.post-row-title
          a(href=url_for(post.path))= post.title
        if post_excerpt(post, 175)
          p.post-row-excerpt= post_excerpt(post, 175)
        if tags.length
          .post-row-tags
            each tag in tags
              a.chip(href=url_for(tag.path)) # #{tag.name}
      a.post-row-arrow(href=url_for(post.path), aria-label='阅读 ' + post.title)
        +icon('arrow', 18)
