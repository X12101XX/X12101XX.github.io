include icons
- var menu = theme.menu || []
- var socials = theme.social || []
.mobile-menu(id='mobile-menu', hidden)
  .mobile-menu-inner
    nav.mobile-nav(aria-label='Mobile')
      each item, index in menu
        - var mobileActive = is_active_nav(item.path, page.path)
        - var mobileIndex = String(index + 1).padStart(2, '0')
        a(href=url_for(item.path), class=mobileActive ? 'is-active' : '', aria-current=mobileActive ? 'page' : false, data-menu-close)
          span.mobile-nav-index= mobileIndex
          span.mobile-nav-name= item.name
          +icon('arrow', 16)
    .mobile-menu-foot
      .mobile-socials
        each item in socials
          - var isExternal = item.url && /^https?:\/\//i.test(item.url)
          a.social-link(href=url_for(item.url), aria-label=item.name, target=isExternal ? '_blank' : false, rel=isExternal ? 'noopener noreferrer' : false)
            +icon(item.icon, 16)
      button.search-trigger.search-trigger--mobile(type='button', data-search-open, data-menu-close, aria-label='Search notes', aria-haspopup='dialog')
        +icon('search', 14)
        span Search
