- var sectionTitle = page.title
- if (page.layout === 'index' || (!page.layout && is_home())) sectionTitle = '文章'
- if (page.layout === 'archive' || is_archive()) sectionTitle = '归档'
- if (page.layout === 'categories') sectionTitle = '分类'
- if (page.layout === 'tags') sectionTitle = '标签'
- var docTitle = page.layout === 'landing' ? (config.title + (config.subtitle ? ' — ' + config.subtitle : '')) : (sectionTitle ? sectionTitle + ' · ' + config.title : config.title)
- var rawDescription = page.description || page.excerpt || config.description || ''
- var description = strip_html(rawDescription).replace(/\s+/g, ' ').trim()
- var canonicalPath = page.path === 'index.html' ? '/' : url_for(page.path)
- var canonical = config.url.replace(/\/$/, '') + canonicalPath
- var shareImage = config.url.replace(/\/$/, '') + url_for(theme.author.avatar || '/images/avatar.jpg')
meta(charset='utf-8')
meta(name='viewport', content='width=device-width, initial-scale=1')
meta(name='color-scheme', content='light dark')
meta(name='theme-color', content='#F4F1EA')
title= docTitle
meta(name='description', content=description)
meta(name='author', content=theme.author.name || config.author)
link(rel='canonical', href=canonical)
link(rel='icon', href=url_for('/favicon.svg'), type='image/svg+xml')
link(rel='apple-touch-icon', href=url_for(theme.author.avatar || '/images/avatar.jpg'))
link(rel='alternate', type='application/atom+xml', title=config.title, href=url_for('/atom.xml'))
link(rel='preload', href=url_for('/fonts/archivo.woff2'), as='font', type='font/woff2', crossorigin='anonymous')
link(rel='preload', href=url_for('/fonts/ibm-plex-mono.woff2'), as='font', type='font/woff2', crossorigin='anonymous')
if /class="katex(?:\s|")/.test((page.content || '') + (page.excerpt || ''))
  link(rel='stylesheet', href=url_for('/vendor/katex/katex.min.css') + '?v=' + assetVersion)
link(rel='stylesheet', href=url_for('/css/base.css') + '?v=' + assetVersion)
link(rel='stylesheet', href=url_for('/css/landing.css') + '?v=' + assetVersion)
link(rel='stylesheet', href=url_for('/css/article.css') + '?v=' + assetVersion)
link(rel='stylesheet', href=url_for('/css/pages.css') + '?v=' + assetVersion)
link(rel='stylesheet', href=url_for('/css/search.css') + '?v=' + assetVersion)
link(rel='stylesheet', href=url_for('/css/responsive.css') + '?v=' + assetVersion)
meta(property='og:type', content=page.layout === 'post' ? 'article' : 'website')
meta(property='og:title', content=docTitle)
meta(property='og:description', content=description)
meta(property='og:url', content=canonical)
meta(property='og:site_name', content=config.title)
meta(property='og:image', content=shareImage)
meta(property='og:locale', content='zh_CN')
meta(name='twitter:card', content='summary')
meta(name='twitter:title', content=docTitle)
meta(name='twitter:description', content=description)
meta(name='twitter:image', content=shareImage)
style.
  html { background: #F4F1EA; color-scheme: light; }
  html[data-theme='dark'] { background: #0E0E0D; color-scheme: dark; }
script.
  (function () {
    try {
      var saved = localStorage.getItem('theme');
      var theme = (saved === 'light' || saved === 'dark') ? saved : 'light';
      document.documentElement.dataset.theme = theme;
      var meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute('content', theme === 'dark' ? '#0E0E0D' : '#F4F1EA');
    } catch (error) {}
    try {
      var key = 'page-transition';
      if (sessionStorage.getItem(key) === '1') {
        sessionStorage.removeItem(key);
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.add('is-transitioning', 'is-entering');
        }
      }
    } catch (error) {}
  })();
