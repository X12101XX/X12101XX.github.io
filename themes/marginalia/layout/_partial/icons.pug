mixin icon(name, size)
  - var n = size || 18
  case name
    when 'book'
      svg.icon(aria-hidden='true', focusable='false', width=n, height=n, viewBox='0 0 24 24', fill='none', stroke='currentColor', stroke-width='1.5', stroke-linecap='round', stroke-linejoin='round')
        path(d='M12 6.1C9.4 4.2 6.8 3.7 4 4.5v13.7c2.8-.8 5.4-.3 8 1.6 2.6-1.9 5.2-2.4 8-1.6V4.5c-2.8-.8-5.4-.3-8 1.6Z')
        path(d='M12 6.1v13.7')
    when 'search'
      svg.icon(aria-hidden='true', focusable='false', width=n, height=n, viewBox='0 0 24 24', fill='none', stroke='currentColor', stroke-width='1.6', stroke-linecap='round')
        circle(cx='10.8', cy='10.8', r='6.8')
        path(d='m20 20-4.4-4.4')
    when 'arrow'
      svg.icon(aria-hidden='true', focusable='false', width=n, height=n, viewBox='0 0 24 24', fill='none', stroke='currentColor', stroke-width='1.5', stroke-linecap='round', stroke-linejoin='round')
        path(d='M6.5 17.5 17.5 6.5')
        path(d='M8 6.5h9.5V16')
    when 'arrow-right'
      svg.icon(aria-hidden='true', focusable='false', width=n, height=n, viewBox='0 0 24 24', fill='none', stroke='currentColor', stroke-width='1.5', stroke-linecap='round', stroke-linejoin='round')
        path(d='M4 12h15')
        path(d='m13 6 6 6-6 6')
    when 'arrow-left'
      svg.icon(aria-hidden='true', focusable='false', width=n, height=n, viewBox='0 0 24 24', fill='none', stroke='currentColor', stroke-width='1.5', stroke-linecap='round', stroke-linejoin='round')
        path(d='M20 12H5')
        path(d='m11 6-6 6 6 6')
    when 'github'
      svg.icon(aria-hidden='true', focusable='false', width=n, height=n, viewBox='0 0 24 24', fill='currentColor')
        path(d='M12 1.7a10.3 10.3 0 0 0-3.26 20.07c.52.1.71-.22.71-.5v-1.76c-2.9.63-3.51-1.23-3.51-1.23-.47-1.2-1.16-1.52-1.16-1.52-.95-.65.07-.64.07-.64 1.05.08 1.6 1.08 1.6 1.08.93 1.6 2.45 1.14 3.05.87.1-.68.37-1.14.66-1.4-2.31-.27-4.74-1.16-4.74-5.14 0-1.14.4-2.06 1.07-2.79-.1-.26-.46-1.32.1-2.75 0 0 .87-.28 2.86 1.07a9.9 9.9 0 0 1 5.2 0c1.99-1.35 2.86-1.07 2.86-1.07.56 1.43.2 2.5.1 2.75.67.73 1.07 1.65 1.07 2.79 0 3.99-2.43 4.87-4.75 5.13.38.32.71.96.71 1.93v2.86c0 .28.19.6.72.5A10.3 10.3 0 0 0 12 1.7Z')
    when 'rss'
      svg.icon(aria-hidden='true', focusable='false', width=n, height=n, viewBox='0 0 24 24', fill='none', stroke='currentColor', stroke-width='1.7', stroke-linecap='round')
        path(d='M5 11a8 8 0 0 1 8 8')
        path(d='M5 5a14 14 0 0 1 14 14')
        circle(cx='5.5', cy='18.5', r='1.2', fill='currentColor', stroke='none')
    when 'mail'
      svg.icon(aria-hidden='true', focusable='false', width=n, height=n, viewBox='0 0 24 24', fill='none', stroke='currentColor', stroke-width='1.5', stroke-linecap='round', stroke-linejoin='round')
        rect(x='3', y='5', width='18', height='14', rx='2')
        path(d='m4 7 8 6 8-6')
    when 'link'
      svg.icon(aria-hidden='true', focusable='false', width=n, height=n, viewBox='0 0 24 24', fill='none', stroke='currentColor', stroke-width='1.5', stroke-linecap='round', stroke-linejoin='round')
        path(d='M10 13.5a4.5 4.5 0 0 0 6.4 0l2.1-2.1a4.5 4.5 0 0 0-6.4-6.4L11 6.1')
        path(d='M14 10.5a4.5 4.5 0 0 0-6.4 0l-2.1 2.1a4.5 4.5 0 0 0 6.4 6.4l1.1-1.1')
    when 'copy'
      svg.icon(aria-hidden='true', focusable='false', width=n, height=n, viewBox='0 0 24 24', fill='none', stroke='currentColor', stroke-width='1.5', stroke-linecap='round', stroke-linejoin='round')
        rect(x='8.5', y='8.5', width='11', height='11', rx='2')
        path(d='M15.5 8.5V6a2 2 0 0 0-2-2h-7a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h2.5')
    when 'check'
      svg.icon(aria-hidden='true', focusable='false', width=n, height=n, viewBox='0 0 24 24', fill='none', stroke='currentColor', stroke-width='1.8', stroke-linecap='round', stroke-linejoin='round')
        path(d='m5 12.5 4.5 4.5L19 7')
    when 'close'
      svg.icon(aria-hidden='true', focusable='false', width=n, height=n, viewBox='0 0 24 24', fill='none', stroke='currentColor', stroke-width='1.6', stroke-linecap='round')
        path(d='M6 6l12 12M18 6 6 18')
    when 'menu'
      svg.icon(aria-hidden='true', focusable='false', width=n, height=n, viewBox='0 0 24 24', fill='none', stroke='currentColor', stroke-width='1.6', stroke-linecap='round')
        path(d='M4 8h16M4 16h16')
    when 'clock'
      svg.icon(aria-hidden='true', focusable='false', width=n, height=n, viewBox='0 0 24 24', fill='none', stroke='currentColor', stroke-width='1.5', stroke-linecap='round', stroke-linejoin='round')
        circle(cx='12', cy='12', r='8.5')
        path(d='M12 7.5V12l3 2')
    when 'chevron-down'
      svg.icon(aria-hidden='true', focusable='false', width=n, height=n, viewBox='0 0 24 24', fill='none', stroke='currentColor', stroke-width='1.6', stroke-linecap='round', stroke-linejoin='round')
        path(d='m6 9 6 6 6-6')
    default
      span
