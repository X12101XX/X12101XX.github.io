extends _partial/base.pug
include _partial/icons
block content
  - var rawPosts = page.posts ? page.posts.toArray() : []
  - var posts = (typeof valid_posts === 'function' ? valid_posts(rawPosts) : rawPosts).filter(function (p) { return p && p.published !== false && p.title && String(p.title).trim(); })
  - var rawSitePosts = site.posts && typeof site.posts.sort === 'function' ? site.posts.sort('-date') : site.posts
  - var validSitePosts = (typeof valid_posts === 'function' ? valid_posts(rawSitePosts) : (rawSitePosts ? rawSitePosts.toArray() : [])).filter(function (p) { return p && p.published !== false && p.title && String(p.title).trim(); })
  - var total = validSitePosts.length
  - var startIndex = (page.current - 1) * config.per_page
  - var latest = validSitePosts[0]
  - var featured = page.current === 1
  - var allCategories = site.categories ? site.categories.toArray().filter(function (c) { return c.length > 0; }).sort(function (a, b) { return b.length - a.length || a.name.localeCompare(b.name); }) : []
  - var topTags = site.tags ? site.tags.toArray().filter(function (t) { return t.length > 0; }).sort(function (a, b) { return b.length - a.length || a.name.localeCompare(b.name); }).slice(0, 12) : []
  main#main.site-main.journal-page
    .shell
      header.page-head.journal-head
        p.eyebrow
          span= theme.journal.kicker || 'ARTICLES'
          span.eyebrow-cn= theme.journal.kicker_cn || '文章索引'
        h1.page-title
          span= theme.journal.heading_before || '全部文章与'
          em= theme.journal.heading_em || '长篇笔记'
        if theme.journal.lede
          p.page-lede= theme.journal.lede
        .page-head-meta
          span 共 #{total} 篇文章
          if latest
            span 最近更新 #{date(latest.date, 'YYYY.MM.DD')}
          a.page-head-link(href=url_for('/archives/'))
            span 查看时间归档
            +icon('arrow-right', 14)
      if allCategories.length || topTags.length
        section.journal-taxonomies(aria-label='主题与标签筛选')
          if allCategories.length
            .journal-tax-group
              span.journal-tax-label 分类
              .journal-tax-list
                each cat in allCategories
                  a.chip.chip--solid(href=url_for(cat.path))
                    span= cat.name
                    span.chip-count= cat.length
          if topTags.length
            .journal-tax-group
              span.journal-tax-label 标签
              .journal-tax-list
                each tag in topTags
                  a.chip(href=url_for(tag.path))
                    span # #{tag.name}
                    span.chip-count= tag.length
      if posts.length
        include _partial/post-rows
        include _partial/pagination
        .journal-tail
          p.journal-tail-note 持续记录，不断打磨，每一篇笔记都源于一个真实的问题。
          a.journal-tail-link(href=url_for('/archives/'))
            span 浏览完整时间线
            +icon('arrow-right', 16)
      else
        .empty-state
          h2 暂无文章
          p 第一篇笔记正在撰写中，敬请期待。
          a.btn.btn--line(href=url_for('/'))
            span 返回首页
            +icon('arrow-right', 15)
