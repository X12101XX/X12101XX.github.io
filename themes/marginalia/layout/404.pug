extends _partial/base.pug
include _partial/icons
block content
  main#main.site-main.error-page
    .shell.error-shell
      p.eyebrow
        span 404
        span.eyebrow-cn 页面未找到
      p.error-code(aria-hidden='true') 404
      h1.error-title
        span 这个页面
        em 似乎走丢了
      p.error-lede 你访问的链接可能已被移动、重命名或尚未存在，你可以返回首页或浏览文章归档。
      .error-actions
        a.btn.btn--solid(href=url_for('/'))
          span 返回首页
          +icon('arrow-right', 16)
        a.btn.btn--line(href=url_for('/posts/'))
          span 浏览文章
          +icon('arrow', 15)
      .error-links
        a(href=url_for('/archives/')) 归档
        span ·
        a(href=url_for('/categories/')) 分类
        span ·
        a(href=url_for('/tags/')) 标签
        span ·
        a(href=url_for('/friends/')) 友链
        span ·
        a(href=url_for('/about/')) 关于
