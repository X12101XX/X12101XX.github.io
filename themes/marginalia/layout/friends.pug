extends _partial/base.pug
include _partial/icons
block content
  - var friends = site.data.friends || []
  - var siteUrl = config.url.replace(/\/$/, '') + '/'
  main#main.site-main.friends-page
    .shell
      header.page-head.friends-head
        p.eyebrow
          span= theme.friends.kicker || 'FRIENDS'
          span.eyebrow-cn= theme.friends.kicker_cn || '友情链接'
        h1.page-title
          span= theme.friends.heading_before || '同样认真写作的'
          em= theme.friends.heading_em || '独立角落'
        if theme.friends.lede
          p.page-lede= theme.friends.lede
        .page-head-meta
          span 共 #{friends.length} 位友邻
          if theme.author.github
            a.page-head-link(href=theme.author.github, target='_blank', rel='noopener noreferrer')
              span 提交友链申请
              +icon('arrow', 14)
      if friends.length
        .friends-grid
          each friend, index in friends
            a.friend-card(href=friend.url, target='_blank', rel='noopener noreferrer')
              span.friend-avatar
                if friend.avatar
                  img(src=url_for(friend.avatar), alt='', loading='lazy', width='56', height='56', data-friend-avatar)
                span.friend-avatar-fallback= initials(friend.name)
              span.friend-body
                span.friend-top
                  span.friend-name= friend.name
                  +icon('arrow', 18)
                span.friend-domain.mono= domain_of(friend.url)
                span.friend-description= friend.description
              span.friend-index.mono= String(index + 1).padStart(2, '0')
      else
        .empty-state
          h2 虚位以待
          p 欢迎更多独立博客加入这里。
      section.friend-invite
        .friend-invite-copy
          p.eyebrow
            span INVITATION
            span.eyebrow-cn 交换友链
          h2 欢迎交换友情链接
          p 如果你也在维护一个独立博客或技术笔记本，欢迎通过 GitHub 与我联系交换友链，附上名称、网址和一句简介即可。
          if theme.author.github
            a.btn.btn--solid(href=theme.author.github, target='_blank', rel='noopener noreferrer')
              span 前往 GitHub 联系
              +icon('arrow', 16)
        .friend-site-card
          p.friend-site-kicker 本站信息
          dl.friend-site-facts
            div
              dt 名称
              dd= theme.author.name || config.author
            div
              dt 网址
              dd= siteUrl.replace(/^https?:\/\//, '')
            div
              dt 简介
              dd= config.subtitle || '代码、工具与理解的个人笔记'
          p.friend-site-note 互换友链只需提供站点名称、链接与一句话描述。
