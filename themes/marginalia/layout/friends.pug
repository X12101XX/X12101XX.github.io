extends _partial/base.pug
include _partial/icons
block content
  - var friends = site.data.friends || []
  - var siteUrl = config.url.replace(/\/$/, '') + '/'
  main#main.site-main.friends-page
    .shell
      header.page-head.friends-head
        p.eyebrow
          +icon('spark', 11)
          span Friends
          span.eyebrow-cn 友情链接
        h1.page-title
          span= theme.friends.heading_before + ' '
          em= theme.friends.heading_em
        p.page-lede= theme.friends.lede
        .page-head-meta
          span #{friends.length} #{friends.length === 1 ? 'kindred corner' : 'kindred corners'}
          if theme.author.github
            a.page-head-link(href=theme.author.github, target='_blank', rel='noopener noreferrer')
              span Suggest a link
              +icon('arrow', 13)
      if friends.length
        .friends-grid
          each friend, index in friends
            a.friend-card(href=friend.url, target='_blank', rel='noopener noreferrer')
              span.friend-avatar
                if friend.avatar
                  img(src=url_for(friend.avatar), alt='', loading='lazy', width='52', height='52', data-friend-avatar)
                span.friend-avatar-fallback= initials(friend.name)
              span.friend-body
                span.friend-top
                  span.friend-name= friend.name
                  +icon('arrow', 17)
                span.friend-domain= domain_of(friend.url)
                span.friend-description= friend.description
                span.friend-index(aria-hidden='true')= '0' + (index + 1)
      else
        .empty-state
          p.empty-state-mark ✳
          h2 The shelf is waiting.
          p Kindred corners will gather here.
      section.friend-invite
        .friend-invite-copy
          p.eyebrow
            +icon('spark', 11)
            span Open invitation
            span.eyebrow-cn 欢迎交换友链
          h2 Good company is worth keeping.
          p If you keep a quiet corner of the web and would like to trade links, write to me on GitHub. A short note and your URL are all it takes.
          if theme.author.github
            a.btn.btn--primary(href=theme.author.github, target='_blank', rel='noopener noreferrer')
              span Say hello
              +icon('arrow', 15)
        .friend-site-card
          .friend-site-mark
            +icon('spark', 22)
          p.friend-site-kicker A small card for your shelf
          dl.friend-site-facts
            div
              dt Name
              dd= theme.author.name || config.author
            div
              dt URL
              dd= siteUrl.replace(/^https?:\/\//, '')
            div
              dt Note
              dd= theme.landing.title
          p.friend-site-note A name, a link, and a line about your corner — that is all.
