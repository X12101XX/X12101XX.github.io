extends _partial/base.pug
include _partial/icons
block content
  - var categories = site.categories.toArray().sort(function (a, b) { return b.length - a.length; })
  main#main.site-main.categories-page
    .shell
      header.page-head
        p.eyebrow
          span= theme.categories.kicker || 'CATEGORIES'
          span.eyebrow-cn= theme.categories.kicker_cn || '主题分类'
        h1.page-title
          span= theme.categories.heading_before || '按主题聚合的'
          em= theme.categories.heading_em || '知识目录'
        p.page-lede= theme.categories.lede
        .page-head-meta
          span 共 #{categories.length} 个分类
          a.page-head-link(href=url_for('/tags/'))
            span 浏览所有标签
            +icon('arrow-right', 13)
      .category-grid
        each category in categories
          section.category-card.spotlight-card
            header.category-card-head
              h2.category-card-title
                a(href=url_for(category.path))= category.name
              span.category-card-count #{category.length} 篇
            ul.category-card-list
              each post in category.posts.toArray().slice(0, 4)
                li
                  a(href=url_for(post.path))
                    time(datetime=date(post.date, 'YYYY-MM-DD'))= date(post.date, 'YYYY-MM-DD')
                    span= post.title
            a.category-card-link(href=url_for(category.path))
              span 查看全部文章
              +icon('arrow-right', 14)
        a.category-card.category-card--index.spotlight-card(href=url_for('/archives/'))
          h2.category-card-title 全部时间归档
          p 按创作顺序回溯每一篇笔记与思考。
          span.category-card-link
            span 进入时间线
            +icon('arrow-right', 14)
      if !categories.length
        .empty-state
          h2 暂无分类
          p 文章积累后，这里会自动展示分类卡片。
